{
  "name": "@kyoungah/agent-presets",
  "version": "1.0.0",
  "description": "Claude Code와 Codex용 공용 규칙 및 워크플로 프리셋 (Next.js / React / TypeScript)",
  "keywords": [
    "agents",
    "claude-code",
    "codex",
    "react",
    "nextjs",
    "typescript"
  ],
  "license": "ISC",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
